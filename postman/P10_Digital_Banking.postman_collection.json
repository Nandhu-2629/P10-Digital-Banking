{
  "info": {
    "name": "P10 - Digital Banking Account & Transaction Management",
    "_postman_id": "p10-digital-banking-cia3",
    "description": "Postman collection for all implemented P10 endpoints. Set baseUrl, customerToken, staffToken, accountId, beneficiaryAccountNumber, and beneficiaryId variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "accountNumber",
      "value": ""
    },
    {
      "key": "beneficiaryAccountNumber",
      "value": ""
    },
    {
      "key": "beneficiaryId",
      "value": ""
    },
    {
      "key": "transferAmount",
      "value": "1000"
    }
  ],
  "item": [
    {
      "name": "1. Register Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123!\",\n  \"accountType\": \"savings\"\n}"
        }
      }
    },
    {
      "name": "2. Login Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123!\"\n}"
        }
      }
    },
    {
      "name": "3. Customer Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "4. Staff Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"staff@example.com\",\n  \"password\": \"Password123!\"\n}"
        }
      }
    },
    {
      "name": "5. Staff Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/staff/dashboard",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "staff",
            "dashboard"
          ]
        }
      }
    },
    {
      "name": "6. Pending Approvals",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/staff/pending-approvals",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "staff",
            "pending-approvals"
          ]
        }
      }
    },
    {
      "name": "7. Approve Account",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{accountId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{accountId}}",
            "approve"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Approved\",\n  \"remarks\": \"KYC documents reviewed and confirmed\"\n}"
        }
      }
    },
    {
      "name": "8. My Accounts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts"
          ]
        }
      }
    },
    {
      "name": "9. Account Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{accountId}}"
          ]
        }
      }
    },
    {
      "name": "10. Deposit Demo Funds",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/deposit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "deposit"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": 10000\n}"
        }
      }
    },
    {
      "name": "11. Add Beneficiary",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/beneficiaries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "beneficiaries"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"beneficiaryAccountNumber\": \"{{beneficiaryAccountNumber}}\",\n  \"nickname\": \"Demo Beneficiary\"\n}"
        }
      }
    },
    {
      "name": "12. List Beneficiaries",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/beneficiaries/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "beneficiaries",
            "{{accountId}}"
          ]
        }
      }
    },
    {
      "name": "13. Transfer Funds",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/transfer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "transfer"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountNumber\": \"{{beneficiaryAccountNumber}}\",\n  \"amount\": \"{{transferAmount}}\"\n}"
        }
      }
    },
    {
      "name": "14. Transaction Ledger",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "{{accountId}}"
          ]
        }
      }
    },
    {
      "name": "15. Account Statement",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{accountId}}/statement?from=2026-01-01&to=2026-12-31",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{accountId}}",
            "statement?from=2026-01-01&to=2026-12-31"
          ]
        }
      }
    },
    {
      "name": "16. Flagged Transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/staff/flagged-transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "staff",
            "flagged-transactions"
          ]
        }
      }
    },
    {
      "name": "17. Freeze Account",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{accountId}}/freeze",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{accountId}}",
            "freeze"
          ]
        }
      }
    },
    {
      "name": "18. Unfreeze Account",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{accountId}}/unfreeze",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{accountId}}",
            "unfreeze"
          ]
        }
      }
    },
    {
      "name": "19. Run Interest Job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/jobs/interest",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "jobs",
            "interest"
          ]
        }
      }
    },
    {
      "name": "20. Delete Beneficiary",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/beneficiaries/{{beneficiaryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "beneficiaries",
            "{{beneficiaryId}}"
          ]
        }
      }
    },
    {
      "name": "21. Validation Failure",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/transfer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "transfer"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromAccountId\": \"not-an-id\",\n  \"toAccountNumber\": \"\",\n  \"amount\": -1\n}"
        }
      }
    },
    {
      "name": "22. Unauthorized Request",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/staff/dashboard",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "staff",
            "dashboard"
          ]
        }
      }
    }
  ]
}